# Copy to .env (gitignored) and adjust before `docker compose --profile sim up -d --build`.

# Password for the sandbox's remote-control PWA (third auth factor, on top of
# the secret path baked into the pairing link). Change this before exposing
# the port beyond localhost.
TAKKUB_SIM_PASSWORD=sandbox

# Host port the PWA is published on.
TAKKUB_BIND_PORT=8899
