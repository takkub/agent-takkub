# Copy to .env (gitignored) and adjust before `docker compose --profile sim up -d --build`.

# Password for the sandbox's remote-control PWA (third auth factor, on top of
# the secret path baked into the pairing link). REQUIRED — the sandbox will
# not start without one, and refuses well-known values such as `sandbox`.
# The line below is a placeholder, not a usable password: replace it with
# your own (8+ characters) and never commit the real one.
TAKKUB_SIM_PASSWORD=replace-with-your-own-password

# Host port the PWA is published on — bound to 127.0.0.1 only. To reach it
# from another machine use an authenticating reverse proxy or a VPN; never
# publish the port straight to the internet (see SECURITY.md).
TAKKUB_BIND_PORT=8899
