{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Takkub Editor File State",
  "type": "object",
  "required": [
    "project_id",
    "path",
    "version"
  ],
  "properties": {
    "project_id": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "version": {
      "type": "object",
      "required": [
        "mtime_ns",
        "size"
      ],
      "properties": {
        "mtime_ns": {
          "type": "integer"
        },
        "size": {
          "type": "integer"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "dirty": {
      "type": "boolean"
    },
    "language": {
      "type": [
        "string",
        "null"
      ]
    },
    "encoding_unsupported": {
      "type": "boolean",
      "description": "True when the file is text-shaped but its bytes fail strict UTF-8 decoding (BUG-005) — opened read-only, save rejected."
    }
  },
  "additionalProperties": false
}